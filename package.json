  "version": "0.1.0",
  "description": "Local-first video studio: turn your own images, clips, scripts and audio into MP4 videos entirely in the browser.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
